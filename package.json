{
  "name": "pi-ship",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi extension: raise a PR from a ticket id without touching your working checkout",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ship:debug": "node scripts/ship-debug.ts",
    "ship:debug:live": "node scripts/ship-debug.ts live"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.0",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
